# Neon pooled connection string for the application runtime
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB?sslmode=require"

# Neon direct (unpooled) connection string for Prisma migrations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST/DB?sslmode=require"

# Generate a unique, random value for each environment
JWT_SECRET="replace-with-a-long-random-secret"
